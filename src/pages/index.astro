---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import imagesData from '../data/images.json';

import heroImg from '../assets/images/hero/hero-1.jpg';

import ed1 from '../assets/images/editorial/editorial-4.jpg';
import ed2 from '../assets/images/editorial/editorial-5.jpg';
import ed3 from '../assets/images/editorial/editorial-6.jpg';

import la1 from '../assets/images/layout/layout-8.jpg';
import la2 from '../assets/images/layout/layout-9.jpg';
import la3 from '../assets/images/layout/layout-10.jpg';

import lu1 from '../assets/images/lumea/lumea-13.jpg';
import lu2 from '../assets/images/lumea/lumea-14.jpg';
import lu3 from '../assets/images/lumea/lumea-15.jpg';

import de1 from '../assets/images/desserts/desserts-25.jpg';
import de2 from '../assets/images/desserts/desserts-26.jpg';
import de3 from '../assets/images/desserts/desserts-27.jpg';

const allImages = import.meta.glob<{ default: ImageMetadata }>('../assets/images/*/*.jpg', { eager: true });

const heroMeta = imagesData.hero[0];

const SC = ['#2a120b', '#7a2a12', '#c78a1c', '#e8b230', '#8c4a2a', '#d8c5b8', '#4a1a14', '#1b1b1b', '#a3141b'];
const stripeBars = Array.from({ length: 64 }, (_, i) => ({
  flex: 1 + ((i * 37) % 5),
  background: `linear-gradient(${SC[(i * 5) % 9]}, ${SC[((i * 3 + 2) % 9)]})`,
}));

const projects = [
  {
    num: '01',
    titleLine1: 'Editorial',
    titleLine2: 'Writing',
    href: '#editorial',
    imgs: [
      { src: ed1, meta: imagesData.editorial[0] },
      { src: ed2, meta: imagesData.editorial[1] },
      { src: ed3, meta: imagesData.editorial[2] },
    ],
  },
  {
    num: '02',
    titleLine1: 'Layout',
    titleLine2: 'Design',
    href: '#layout',
    imgs: [
      { src: la1, meta: imagesData.layout[0] },
      { src: la2, meta: imagesData.layout[1] },
      { src: la3, meta: imagesData.layout[2] },
    ],
  },
  {
    num: '03',
    titleLine1: 'Branding',
    titleLine2: 'Lumea',
    href: '#lumea',
    imgs: [
      { src: lu1, meta: imagesData.lumea[0] },
      { src: lu2, meta: imagesData.lumea[1] },
      { src: lu3, meta: imagesData.lumea[2] },
    ],
  },
  {
    num: '04',
    titleLine1: 'Visual',
    titleLine2: 'Identity',
    href: '#desserts',
    imgs: [
      { src: de1, meta: imagesData.desserts[0] },
      { src: de2, meta: imagesData.desserts[1] },
      { src: de3, meta: imagesData.desserts[2] },
    ],
  },
];

const projectPages = [
  {
    id: 'editorial',
    num: '01',
    name: 'Editorial Writing',
    script: 'Editorial Writing',
    txt: 'Spreads on street style, self-expression and experimental fashion from the CULTURE zine.',
    nextId: 'layout',
    nextScript: 'Dastak',
    prevId: 'desserts',
    prevScript: 'City of Desserts',
    images: imagesData.editorial.map((item) => ({
      src: allImages[`../assets/images/editorial/${item.file}`].default,
      width: item.width,
      height: item.height,
      alt: item.alt,
    })),
  },
  {
    id: 'layout',
    num: '02',
    name: 'Layout Design',
    script: 'Dastak',
    txt: 'DASTAK — The City Magazine is a visual exploration of architecture and the stories embedded within Indian cities. A series of covers shaped by photographs of Bombay, Rajasthan, Agra and Kochi, each with its own character under one consistent identity.',
    nextId: 'lumea',
    nextScript: 'Lumea',
    prevId: 'editorial',
    prevScript: 'Editorial Writing',
    images: imagesData.layout.map((item) => ({
      src: allImages[`../assets/images/layout/${item.file}`].default,
      width: item.width,
      height: item.height,
      alt: item.alt,
    })),
  },
  {
    id: 'lumea',
    num: '03',
    name: 'Branding',
    script: 'Lumea',
    txt: 'Lumea is a homegrown scented candle brand inspired by mindfulness, emotional wellness and slow living. Derived from “lume”, light, it stands for warmth, serenity and quiet luxury.',
    nextId: 'desserts',
    nextScript: 'City of Desserts',
    prevId: 'layout',
    prevScript: 'Dastak',
    images: imagesData.lumea.map((item) => ({
      src: allImages[`../assets/images/lumea/${item.file}`].default,
      width: item.width,
      height: item.height,
      alt: item.alt,
    })),
  },
  {
    id: 'desserts',
    num: '04',
    name: 'Branding & Visual Identity',
    script: 'City of Desserts',
    txt: 'A one-stop destination for desserts from across India and around the world: Jalebi, Payasam, Rasmalai, Ghewar beside cheesecake, tiramisu and brownies, in one contemporary dessert house.',
    nextId: 'editorial',
    nextScript: 'Editorial Writing',
    prevId: 'lumea',
    prevScript: 'Lumea',
    images: imagesData.desserts.map((item) => ({
      src: allImages[`../assets/images/desserts/${item.file}`].default,
      width: item.width,
      height: item.height,
      alt: item.alt,
    })),
  },
];

const bioText = "Hi, I’m Ishita, and I love to create, research, and explore every form of art and design. Photography, travelling, and architecture are my favourite forms of art. I love to research trends, study fashion, create graphics, write, and build brand identities. I am currently in my fourth year of communication design in fashion, and I continue to learn, explore, and create every single day. This portfolio aims to showcase everything I love to do in this creative realm I am in.";

const portLetters = [...'PORT'];
const folioLetters = [...'FOLIO'];
---

<Layout title="Ishita Yadav — Portfolio 2026">
  <a href="#app" class="skip-link">Skip to main content</a>
  <header>
    <a href="#home" class="brand-link" id="brand-link">
      <span class="back-arrow" aria-hidden="true">←</span>
      <span>Ishita Yadav</span>
    </a>
    <span id="cur">Portfolio 2026</span>
  </header>

  <div id="bars" aria-hidden="true"></div>

  <main id="app">
    <!-- Home View -->
    <div id="view-home">
      <!-- Hero Section -->
      <section class="hero" id="home">
        <div class="himg">
          <Image
            src={heroImg}
            width={heroMeta.width}
            height={heroMeta.height}
            alt={heroMeta.alt}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <h1 class="ttl disp" aria-label="Ishita Yadav, Portfolio 2026">
          <span class="by">By Ishita Yadav</span>
          <span class="ln" aria-hidden="true">
            {portLetters.map((c, i) => (
              <span class="l" style={`--d: ${i};`}>{c}</span>
            ))}
          </span>
          <span class="ln" aria-hidden="true">
            {folioLetters.map((c, i) => (
              <span class="l" style={`--d: ${i + 4};`}>{c}</span>
            ))}
          </span>
        </h1>
      </section>

      <!-- Signature Stripe Divider -->
      <div class="stripe stripe-trigger" aria-hidden="true">
        {stripeBars.map((bar, i) => (
          <i style={`--i: ${i}; flex: ${bar.flex}; background: ${bar.background};`}></i>
        ))}
      </div>

      <!-- About Section -->
      <section class="intro" id="about">
        <h2 class="disp rv">A brief<br />intro<br />about me</h2>
        <div>
          <div class="kick rv">4th year · Communication Design in Fashion</div>
          <p class="rv">{bioText}</p>
          <div class="about-resume-wrap rv">
            <a href="/resume/Ishita-Yadav-Resume.pdf" target="_blank" rel="noopener noreferrer" class="about-resume-link">
              View Résumé ↗
            </a>
          </div>
        </div>
      </section>

      <!-- Project Index -->
      <section id="idx" class="dim">
        {projects.map((proj) => (
          <a class="row rv" href={proj.href} data-k={proj.href.replace('#', '')}>
            <span class="n">{proj.num}</span>
            <span class="t disp">
              {proj.titleLine1}
              <br />
              {proj.titleLine2}
            </span>
            <span class="s">
              {proj.imgs.map((im, j) => (
                <Image
                  src={im.src}
                  width={im.meta.width}
                  height={im.meta.height}
                  alt={im.meta.alt}
                  class:list={[{ on: j === 0 }]}
                  loading={j === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              ))}
              <em>View project →</em>
            </span>
          </a>
        ))}
      </section>
    </div>

    <!-- Project Views -->
    {projectPages.map((proj) => (
      <article id={`proj-${proj.id}`} class="proj-view" data-proj={proj.id} hidden>
        <section class="pv">
          <div class="kick">{proj.num} — {proj.name}</div>
          <h1 class="big">{proj.script}</h1>
          <p class="txt rv">{proj.txt}</p>
          <div class="g">
            {proj.images.map((im) => (
              <figure class="rv">
                <Image
                  src={im.src}
                  width={im.width}
                  height={im.height}
                  alt={im.alt}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))}
          </div>
          <div class="proj-nav rv">
            <a class="prev" href={`#${proj.prevId}`}>
              <span class="kick">Previous project</span>
              <b>{proj.prevScript}</b>
            </a>
            <a class="next" href={`#${proj.nextId}`}>
              <span class="kick">Next project</span>
              <b>{proj.nextScript}</b>
            </a>
          </div>
        </section>
      </article>
    ))}
  </main>

  <!-- Footer -->
  <footer>
    <div class="footer-wrap">
      <div class="footer-contact">
        <a href="mailto:ishitayadav170@gmail.com" class="footer-link">ishitayadav170@gmail.com</a>
        <span class="footer-sep">·</span>
        <a href="tel:+918937999255" class="footer-link">+91 89379 99255</a>
        <span class="footer-sep">·</span>
        <a href="https://www.linkedin.com/in/ishita-yadav-968899277" target="_blank" rel="noopener noreferrer" class="footer-link">LinkedIn</a>
      </div>
      <div>
        <a href="/resume/Ishita-Yadav-Resume.pdf" target="_blank" rel="noopener noreferrer" class="footer-link">
          Download Résumé ↓
        </a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 22px;
    z-index: 100;
    padding: 8px 16px;
    background: var(--ink);
    color: var(--bg);
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: top 0.2s ease;
  }

  .skip-link:focus-visible {
    top: calc(14px + env(safe-area-inset-top, 0px));
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 3px;
  }

  #home,
  #about,
  #idx,
  #app,
  .pv {
    scroll-margin-top: calc(56px + env(safe-area-inset-top, 0px));
  }

  .intro h2,
  .row .t,
  .big {
    text-wrap: balance;
  }

  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: calc(14px + env(safe-area-inset-top, 0px)) 22px 14px;
    color: #fff;
    mix-blend-mode: difference;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  /* Prevent long project label from colliding with brand name on narrow viewports */
  #cur {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    max-width: 55%;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    flex-shrink: 0;
  }

  .back-arrow {
    display: inline-block;
    opacity: 0;
    max-width: 0;
    transform: translateX(4px);
    overflow: hidden;
    white-space: nowrap;
    transition: opacity 0.25s ease, max-width 0.25s ease, transform 0.25s ease;
    font-size: 12px;
    line-height: 1;
  }

  :global(:root[data-project]) .back-arrow {
    opacity: 1;
    max-width: 18px;
    transform: translateX(0);
  }

  @media (hover: hover) {
    /* Fix 1: strip hidden by default; clip-path wipe reveals cover when row is hovered */
    .s {
      clip-path: inset(0 100% 0 0);
      transition: clip-path 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .row:hover .s {
      clip-path: inset(0 0% 0 0);
    }

    :global(:root[data-project]) .brand-link:hover .back-arrow {
      transform: translateX(-3px);
    }

    .about-resume-link:hover {
      opacity: 0.75;
    }

    #idx.dim:hover .row:not(:hover) {
      opacity: 0.3;
    }

    .row:hover:before {
      transform: scaleX(1);
    }

    .row:hover .n {
      color: var(--acc);
    }

    .row:hover .t {
      transform: translateX(22px);
      color: var(--acc);
    }

    .prev:hover b {
      transform: translateX(18px);
    }

    .next:hover b {
      transform: translateX(-18px);
    }

    .footer-link:hover {
      color: var(--acc);
    }
  }

  #bars {
    position: fixed;
    inset: 0;
    display: flex;
    z-index: 9;
    pointer-events: none;
  }

  #bars :global(i) {
    flex: 1;
    display: block;
    transform: scaleY(0);
  }

  .proj-view {
    min-height: 100svh;
  }

  .proj-view[hidden] {
    display: none !important;
  }

  #view-home[hidden] {
    display: none !important;
  }

  .hero {
    min-height: 100svh;
    display: grid;
    grid-template-rows: 62svh 1fr;
    position: relative;
  }

  .himg {
    overflow: hidden;
    position: relative;
  }

  .himg :global(img) {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 115%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: grayscale(1) contrast(1.05);
    animation: scan 1.8s cubic-bezier(0.7, 0, 0.2, 1) both;
  }

  .himg:after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(0deg, var(--bg) 0 2px, transparent 2px 4px);
    pointer-events: none;
    animation: fade 2.4s 0.2s forwards;
  }

  @keyframes scan {
    from {
      clip-path: inset(0 0 100% 0);
      transform: scale(1.1);
    }
    to {
      clip-path: inset(0);
      transform: none;
    }
  }

  @keyframes fade {
    to {
      opacity: 0;
    }
  }

  .ttl {
    margin: 0;
    font-weight: 500;
    align-self: end;
    text-align: right;
    padding: 0 22px 22px;
    color: var(--acc);
    font-size: clamp(64px, 16vw, 230px);
    line-height: 0.84;
    letter-spacing: -0.03em;
    position: relative;
  }

  .ln {
    display: block;
    overflow: hidden;
    padding-top: 0.05em;
  }

  .l {
    display: inline-block;
    transform: translateY(110%);
    animation: up 0.95s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: calc(0.5s + var(--d) * 70ms);
  }

  @keyframes up {
    to {
      transform: none;
    }
  }

  .by {
    position: absolute;
    left: 22px;
    bottom: 22px;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: var(--acc);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .stripe {
    display: flex;
    gap: 3px;
    height: 96px;
    filter: blur(0.6px);
    margin: 56px 22px 0;
  }

  .stripe i {
    display: block;
    height: 100%;
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: calc(var(--i) * 22ms);
  }

  :global(.in) .stripe i,
  .stripe:global(.in) i,
  :global(.stripe-trigger.in) i {
    transform: none;
  }

  .intro {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(24px, 6vw, 100px);
    padding: 64px 22px 110px;
    align-items: end;
  }

  .intro > div {
    border-top: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    padding-top: 20px;
  }

  .intro h2 {
    margin: 0;
    font-size: clamp(40px, 6.4vw, 100px);
    line-height: 0.92;
    color: var(--acc);
    text-align: left;
  }

  .kick {
    text-transform: uppercase;
    font-size: 11px;
    color: var(--mut);
    margin-bottom: 18px;
    letter-spacing: 0.05em;
  }

  .intro p {
    max-width: 50ch;
    margin: 0;
    font-size: clamp(16px, 1.55vw, 21px);
    line-height: 1.6;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .about-resume-wrap {
    margin-top: 24px;
  }

  .about-resume-link {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--acc);
    display: inline-flex;
    align-items: center;
    border-bottom: 1px solid var(--acc);
    /* 44 px minimum tap target */
    padding-block: 16px;
    margin-block: -16px;
  }

  #idx {
    display: block;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr minmax(0, 38vw);
    align-items: center;
    gap: 16px;
    padding: 22px;
    border-top: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    cursor: pointer;
    transition: opacity 0.4s ease, background-color 0.3s ease;
  }

  .row:before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    height: 1px;
    width: 100%;
    background: var(--acc);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s cubic-bezier(0.7, 0, 0.2, 1);
  }

  .row .n {
    color: var(--mut);
    font-size: 12px;
    transition: color 0.3s;
  }

  .row .t {
    font-size: clamp(30px, 6.4vw, 92px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.3s;
  }

  .row .s {
    position: relative;
    /* Raise the ceiling so tall viewports don't get a 3.6:1 sliver */
    height: clamp(70px, 13vw, 200px);
    overflow: hidden;
  }

  .s :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 0.6s ease, transform 1.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .s :global(img.on) {
    opacity: 1;
    transform: scale(1.07);
  }

  .s em {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 2;
    font-style: normal;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    background: var(--acc);
    padding: 4px 10px;
  }

  @media (hover: none) {
    .s :global(img:first-child) {
      opacity: 1;
    }
    .s em {
      display: none;
    }
  }

  /* Project View Styles */
  .pv {
    padding: calc(96px + env(safe-area-inset-top, 0px)) 22px 60px;
  }

  .big {
    font-family: 'Pinyon Script', cursive;
    /* Floor raised to keep text readable; vw unit provides the smooth scale */
    font-size: clamp(44px, 12vw, 220px);
    line-height: 1.1;
    color: var(--acc);
    margin: 8px 0 0;
    /* Allow script words to wrap rather than overflow on narrow phones */
    overflow-wrap: break-word;
    clip-path: inset(-20% 100% -20% 0);
    animation: wipe 1.3s 0.55s cubic-bezier(0.7, 0, 0.2, 1) forwards;
  }

  @keyframes wipe {
    to {
      clip-path: inset(-20% -10% -20% 0);
    }
  }

  .txt {
    max-width: 54ch;
    margin: 20px 0 52px auto;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.05em;
    line-height: 1.7;
  }

  .g {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 14px;
    perspective: 1100px;
  }

  .g figure {
    margin: 0;
    grid-column: span 6;
  }

  .g figure:nth-child(3n + 1) {
    grid-column: span 12;
  }

  /* Fix 2: every image in the layout project is full-width */
  #proj-layout .g figure {
    grid-column: span 12;
  }

  .g :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .proj-nav {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 90px;
    gap: 24px;
  }

  .prev,
  .next {
    display: block;
  }

  .prev {
    text-align: left;
  }

  .next {
    text-align: right;
  }

  .prev b,
  .next b {
    display: block;
    /* Floor lowered from 44 → 34px so long script titles don't overflow at 360 px */
    font: 400 clamp(34px, 10vw, 150px) / 1.1 'Pinyon Script', cursive;
    color: var(--acc);
    overflow-wrap: break-word;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .rv {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 1s, transform 1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  :global(.rv.in) {
    opacity: 1 !important;
    transform: none !important;
  }


  footer {
    border-top: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    padding: 40px 22px 60px;
    text-transform: uppercase;
    font-size: 11px;
    color: var(--mut);
  }

  .footer-wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer-link {
    /* 44 px tap target: negative margin keeps visual spacing unchanged */
    display: inline-flex;
    align-items: center;
    padding-block: 13px;
    margin-block: -13px;
    transition: color 0.2s ease;
  }

  .footer-contact {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .footer-sep {
    color: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  /* Collapse intro to single column earlier — catches landscape phones (≈768 px wide) */
  @media (max-width: 820px) {
    .intro {
      grid-template-columns: 1fr;
    }

    .intro h2 {
      order: 0;
      text-align: left;
    }
  }

  @media (max-width: 700px) {
    /* Collapse hero: image at natural ratio, title sits tight below — no 1fr stretch gap */
    .hero {
      min-height: unset;
      grid-template-rows: auto auto;
    }

    .himg {
      aspect-ratio: 1920 / 801;
    }

    /* Remove parallax oversizing — not needed at mobile widths */
    .himg :global(img) {
      height: 100%;
    }

    /* Tighter title padding below the image */
    .ttl {
      padding: 14px 14px 20px;
      font-size: clamp(56px, 15vw, 80px);
    }

    .row {
      grid-template-columns: 34px 1fr 30vw;
      padding: 18px 14px;
    }

    .footer-wrap {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .g figure,
    .g figure:nth-child(3n + 1) {
      grid-column: span 12;
    }

    .txt {
      margin-left: 0;
    }

    /* Project page mobile */
    .pv {
      padding: calc(72px + env(safe-area-inset-top, 0px)) 16px 48px;
    }

    .proj-nav {
      margin-top: 56px;
      flex-direction: column;
      align-items: stretch;
    }

    .prev {
      text-align: left;
    }

    .next {
      text-align: right;
    }

    .stripe {
      height: 64px;
      margin: 36px 14px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }

    .l {
      opacity: 1;
      transform: none !important;
    }

    .himg:after {
      display: none;
    }

    .rv,
    .big,
    .stripe i {
      opacity: 1 !important;
      transform: none !important;
      clip-path: none !important;
    }
  }
</style>

<script>
  // Pre-load and warm Pinyon Script immediately to eliminate FOUT font glitching
  if ('fonts' in document) {
    document.fonts.load('400 60px "Pinyon Script"');
  }

  const meta: Record<string, { num: string; name: string }> = {
    editorial: { num: '01', name: 'Editorial Writing' },
    layout: { num: '02', name: 'Layout Design' },
    lumea: { num: '03', name: 'Branding' },
    desserts: { num: '04', name: 'Branding & Visual Identity' },
  };

  const barColors: Record<string, string[]> = {
    editorial: ['#f6f3ee', '#a3141b', '#17110f', '#d9d2c7'],
    layout: ['#6e0f1a', '#f2b01e', '#1230c8', '#f5ead3', '#17110f'],
    lumea: ['#2d150e', '#5b3326', '#9c7458', '#d8c5b8'],
    desserts: ['#1f0e09', '#412b20', '#522d1d', '#8a9a6b', '#d8c5b8'],
    home: ['#a3141b', '#17110f', '#e8a317', '#6b2a14', '#d8c5b8'],
  };

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  function initObservers() {
    // Remove .in from all rv elements to reset
    document.querySelectorAll('.rv').forEach((el) => {
      el.classList.remove('in');
    });
    // Let DOM paint after hidden->visible switch, then observe
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        document.querySelectorAll('.rv').forEach((el) => {
          const rect = el.getBoundingClientRect();
          // Immediately reveal elements already in viewport
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            el.classList.add('in');
          } else {
            io.observe(el);
          }
        });
        // Stripe bars rise on scroll into view
        document.querySelectorAll('.stripe-trigger').forEach((el) => {
          el.classList.remove('in');
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            el.classList.add('in');
          } else {
            io.observe(el);
          }
        });
      });
    });
  }

  function initTilt() {
    if (!window.matchMedia('(hover: hover)').matches || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('.g figure').forEach((f) => {
      f.style.transition = 'rotate 0.35s ease-out';
      f.onmousemove = (e) => {
        const r = f.getBoundingClientRect();
        const normX = (e.clientX - r.left) / r.width - 0.5;
        f.style.rotate = `0 1 0 ${normX * 2}deg`;
      };
      f.onmouseleave = () => {
        f.style.rotate = '0deg';
      };
    });
  }

  // Hero parallax — image drifts down at 0.22x, title rises at 0.06x
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function hp() {
    if (reduced) return;
    const hv = document.getElementById('view-home');
    if (!hv || hv.hidden) return;
    const img = hv.querySelector<HTMLElement>('.himg img');
    const ttl = hv.querySelector<HTMLElement>('.ttl');
    const sy = window.scrollY;
    if (img && sy < window.innerHeight * 1.3) {
      img.style.translate = `0 ${Math.min(sy * 0.22, window.innerHeight * 0.15)}px`;
    }
    if (ttl) {
      ttl.style.translate = `0 ${-sy * 0.06}px`;
    }
  }
  window.addEventListener('scroll', hp, { passive: true });
  hp(); // run once on load

  let busy = false;

  function switchView(k: string) {
    const isProj = ['editorial', 'layout', 'lumea', 'desserts'].includes(k);
    const homeView = document.getElementById('view-home');
    const projViews = document.querySelectorAll<HTMLElement>('.proj-view');
    const curSpan = document.getElementById('cur');
    const brandLink = document.getElementById('brand-link');

    if (isProj) {
      if (homeView) homeView.hidden = true;
      projViews.forEach((pv) => {
        pv.hidden = pv.dataset.proj !== k;
      });
      document.documentElement.dataset.project = k;
      const d = meta[k];
      if (curSpan && d) {
        curSpan.textContent = `${d.num} / ${d.name}`;
      }
      if (brandLink) {
        brandLink.setAttribute('aria-label', 'Back to home');
        brandLink.setAttribute('title', 'Back to home');
      }
    } else {
      // Track whether we're returning from a project (homeView was hidden)
      // vs. the initial page load (homeView was never hidden).
      const returningHome = homeView ? homeView.hidden : false;
      if (homeView) homeView.hidden = false;
      projViews.forEach((pv) => {
        pv.hidden = true;
      });
      delete document.documentElement.dataset.project;
      if (curSpan) {
        curSpan.textContent = 'Portfolio 2026';
      }
      if (brandLink) {
        brandLink.removeAttribute('aria-label');
        brandLink.removeAttribute('title');
      }
      // Only freeze on return — not on initial load, so the entrance animation plays normally.
      // Mobile browsers replay CSS animations when display:none → block, causing a glitch.
      if (returningHome) {
        requestAnimationFrame(() => {
          const heroImg = homeView?.querySelector<HTMLElement>('.himg img');
          if (heroImg) {
            heroImg.style.animation = 'none';
            heroImg.style.clipPath = 'inset(0)';
            heroImg.style.transform = '';
            heroImg.style.translate = '0 0px';
          }
          const ttl = homeView?.querySelector<HTMLElement>('.ttl');
          if (ttl) ttl.style.translate = '0 0px';
        });
      }
    }

    if (!isProj && k && k !== 'home') {
      const targetEl = document.getElementById(k);
      if (targetEl) {
        requestAnimationFrame(() => {
          targetEl.scrollIntoView({ behavior: 'smooth' });
        });
      } else {
        window.scrollTo(0, 0);
      }
    } else {
      window.scrollTo(0, 0);
    }
    initObservers();
    initTilt();

    // Restart .big wipe animation
    requestAnimationFrame(() => {
      const big = document.querySelector<HTMLElement>('.proj-view:not([hidden]) .big');
      if (big) {
        big.style.animation = 'none';
        // Trigger reflow
        void big.offsetWidth;
        big.style.animation = '';
      }
    });
  }

  function go(k: string) {
    if (busy) return;
    const isTargetProj = ['editorial', 'layout', 'lumea', 'desserts'].includes(k);
    const homeView = document.getElementById('view-home');
    const isHomeActive = homeView && !homeView.hidden;

    // In-page section link (e.g. #about, #idx, #home, #app) while already on home view: scroll smoothly without page transition
    if (!isTargetProj && isHomeActive) {
      const targetId = k === 'home' || !k ? 'home' : k;
      const targetEl = document.getElementById(targetId);
      if (targetEl) {
        targetEl.scrollIntoView({ behavior: 'smooth' });
        return;
      }
    }

    const targetKey = isTargetProj ? k : 'home';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      switchView(targetKey);
      return;
    }

    busy = true;
    const cols = barColors[targetKey];
    const b = document.getElementById('bars');
    if (!b) {
      switchView(targetKey);
      busy = false;
      return;
    }

    b.innerHTML = Array.from(
      { length: 16 },
      (_, i) => `<i style="background:${cols[i % cols.length]};transform-origin:bottom;transform:scaleY(0)"></i>`
    ).join('');
    const elements = Array.from(b.children) as HTMLElement[];
    const timing: KeyframeAnimationOptions = { duration: 600, easing: 'cubic-bezier(.7,0,.2,1)', fill: 'forwards' };
    const delay = (i: number) => ((i * 7) % 16) * 26;

    const fontReady = 'fonts' in document ? document.fonts.load('400 60px "Pinyon Script"') : Promise.resolve();

    Promise.all([
      ...elements.map((el, i) =>
        el.animate([{ transform: 'scaleY(0)' }, { transform: 'scaleY(1)' }], { ...timing, delay: delay(i) }).finished
      ),
      fontReady,
    ])
      .then(() => {
        switchView(targetKey);
        elements.forEach((el) => {
          el.style.transformOrigin = 'top';
        });
        return Promise.all(
          elements.map((el, i) =>
            el.animate([{ transform: 'scaleY(1)' }, { transform: 'scaleY(0)' }], { ...timing, delay: delay(i) + 120 }).finished
          )
        );
      })
      .then(() => {
        b.innerHTML = '';
        busy = false;
      })
      .catch(() => {
        b.innerHTML = '';
        busy = false;
      });
  }

  // Initial load
  const initialKey = location.hash.replace('#', '');
  if ('fonts' in document && ['editorial', 'layout', 'lumea', 'desserts'].includes(initialKey)) {
    Promise.race([
      document.fonts.load('400 60px "Pinyon Script"'),
      new Promise((res) => setTimeout(res, 300)),
    ]).then(() => {
      switchView(initialKey);
    });
  } else {
    switchView(initialKey);
  }

  window.addEventListener('hashchange', () => {
    const k = location.hash.replace('#', '');
    go(k);
  });

  // Index hover cycling
  if (window.matchMedia('(hover: hover)').matches) {
    let timer: number | undefined;
    let currentKey: string | null = null;

    const stopCycling = () => {
      if (timer) {
        window.clearInterval(timer);
        timer = undefined;
      }
      document.querySelectorAll<HTMLImageElement>('.row .s img').forEach((img) => {
        img.classList.toggle('on', img === img.parentElement?.firstElementChild);
      });
      currentKey = null;
    };

    document.addEventListener('mouseover', (e) => {
      const row = (e.target as HTMLElement).closest<HTMLElement>('.row');
      const key = row?.dataset.k || null;
      if (key === currentKey) return;
      stopCycling();
      if (!row || !key) return;

      currentKey = key;
      const images = Array.from(row.querySelectorAll<HTMLImageElement>('.s img'));
      let idx = 0;

      if (images.length > 1 && !reduced) {
        timer = window.setInterval(() => {
          idx = (idx + 1) % images.length;
          images.forEach((img, j) => {
            img.classList.toggle('on', j === idx);
          });
        }, 1000);
      }
    });

    document.addEventListener('mouseleave', stopCycling);
  }
</script>
